# Base URL of the voz-segura-backend deployment (no trailing slash).
# Local backend: npm run dev in ../VozSegura-backend (PORT=3100 used while developing).
VITE_API_BASE_URL=http://localhost:3100

# Same value as ALERT_API_TOKEN in the backend. Public once built (it is inside the bundle/APK).
VITE_ALERT_API_TOKEN=
